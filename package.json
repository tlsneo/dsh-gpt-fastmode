{
  "name": "@tlsneo/dsh-gpt-fastmode",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "description": "Choose GPT service tiers next to the DSH model selector.",
  "engines": { "dsh": "0.2.2-rc.5" },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": ["index.js", "client.js", "http.js", "cordis.patch.yml", "locale/*.json", "icon.svg"],
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": ["@deepseek-ai/dsh-client-ui-conversation", "@deepseek-ai/dsh-client-ui-model-selection"]
    }
  }
}
